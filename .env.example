API_KEY=change-me
LOG_LEVEL=INFO

POSTGRES_USER=payments
POSTGRES_PASSWORD=postgres-password
POSTGRES_DB=payments
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

RABBITMQ_USER=payments
RABBITMQ_PASSWORD=rabbitmq-password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

API_PUBLISHED_PORT=8000
POSTGRES_PUBLISHED_PORT=5432
RABBITMQ_PUBLISHED_PORT=5672
RABBITMQ_MANAGEMENT_PUBLISHED_PORT=15672

GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9
GATEWAY_TRANSIENT_ERROR_RATE=0.0

PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_BASE_DELAY_MS=2000
CONSUMER_PREFETCH_COUNT=10
CONSUMER_DELIVERY_LIMIT=5

OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_LEASE_SECONDS=60
OUTBOX_RETRY_BASE_DELAY_SECONDS=1
OUTBOX_RETRY_MAX_DELAY_SECONDS=60
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10

WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_DELAY_SECONDS=2
WEBHOOK_RETRY_MAX_DELAY_SECONDS=300
